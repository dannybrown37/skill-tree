#!/usr/bin/env bash
# Interactive `backlog` CLI: fzf pickers around backlog_cli.py.
#
# Ported from dotfiles' bin/queue.sh (a sourced shell function) into a
# standalone executable, so skill-tree is installable without dotfiles --
# `install.sh` just has to put this file on PATH.
set -euo pipefail

_script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

_backlog_py() {
    uv run python "${_script_dir}/backlog_cli.py" "$@"
}

# Repo names the tag picker offers: git repos directly under $PROJECTS_DIR,
# plus "greenfield" for an item that's for a brand-new project with no repo
# to tag yet.
_backlog_repo_candidates() {
    local projects_dir="${PROJECTS_DIR:-${HOME}/projects}" dir
    printf '%s\n' greenfield
    for dir in "${projects_dir}"/*/; do
        # `if`, not `[[ ]] &&` -- under `set -e`, a bare `&&` as the loop's
        # last command makes the *function's* exit status track whichever
        # directory happened to sort last, which poisons the pipe this feeds
        # into and silently kills the caller for any repo lacking a `.git`.
        if [[ -e "${dir}.git" ]]; then
            basename "${dir}"
        fi
    done
}

# fzf a value from stdin, falling back to the typed query if nothing was
# selected -- lets a repo be picked from the list or typed fresh (e.g. one
# only cloned on another machine).
_backlog_pick_or_type() {
    local prompt="$1" result query choice
    result="$(fzf --prompt="${prompt} " --height=40% --reverse --print-query)"
    query="$(head -n1 <<<"${result}")"
    choice="$(sed -n 2p <<<"${result}")"
    printf '%s\n' "${choice:-${query}}"
}

# True if -a/--all is among the given args.
_backlog_has_all_flag() {
    local arg
    for arg in "$@"; do
        [[ "${arg}" == "--all" || "${arg}" == "-a" ]] && return 0
    done
    return 1
}

# The human-facing actions, offered by the bare-`backlog` menu. `titles` and
# the `merge-*` pair are deliberately absent: they exist for the picker and
# the sync mechanism to call, not for a person to choose from a list.
_backlog_actions() {
    cat <<'EOF'
add       Add an item to the bottom -- do this eventually
next      Add an item to the top -- do this next
list      Preview the next items
claim     Mark an item in-progress
complete  Move an item to the completed log
tag       Set, replace, or remove an item's [repo] tag
edit      Open the backlog file directly in $EDITOR
EOF
}

# Bare `backlog` used to mean "add an item", which quietly dropped the user
# into an editor for a *new* item when they may well have meant to read or
# claim one. It now offers every action instead -- one keystroke more for a
# capture, but nothing destructive happens by default.
# A leading flag still counts as "add this" (`backlog --title x`): naming
# the item's fields is already an unambiguous "I'm adding something". But
# -h/--help must reach argparse as-is so it prints real usage.
if [[ $# -eq 0 ]]; then
    selection="$(_backlog_actions |
        fzf --prompt="Which action? " --height=40% --reverse)"

    if [[ -z "${selection}" ]]; then
        echo "backlog: nothing selected" >&2
        exit 1
    fi

    set -- "${selection%% *}"
elif [[ "$1" == -* && "$1" != "-h" && "$1" != "--help" ]]; then
    set -- add "$@"
fi

action="${1:-}"

# Titles have to match exactly, so offer them instead of retyping one. The
# tag picker defaults to only untagged items, so retagging a mistagged item
# needs an explicit -a/--all; claim/complete stay scoped to the current repo.
if [[ ("${action}" == "complete" || "${action}" == "claim" || "${action}" == "tag") &&
    "$*" != *--item-title* ]]; then
    title_extra=()
    if [[ "${action}" == "tag" ]]; then
        if _backlog_has_all_flag "$@"; then
            title_extra=(--all)
        else
            title_extra=(--untagged-only)
        fi
    fi

    title="$(_backlog_py titles "${title_extra[@]}" |
        fzf --prompt="${action^} which item? " --height=40% --reverse)"

    if [[ -z "${title}" ]]; then
        echo "backlog: nothing selected" >&2
        exit 1
    fi

    shift
    set -- "${action}" --item-title "${title}" "$@"
fi

# Untagging (--repo "") has to be passed explicitly -- an empty fzf query
# still matches everything, so it can't mean "no repo" here.
if [[ "${action}" == "tag" && "$*" != *--repo* ]]; then
    repo="$(_backlog_repo_candidates | _backlog_pick_or_type "Tag with which repo?")"

    if [[ -z "${repo}" ]]; then
        echo "backlog: nothing selected" >&2
        exit 1
    fi

    set -- "$@" --repo "${repo}"
fi

# Ask for the title *before* the repo picker. The other way round, choosing a
# repo out of a long fzf list is enough of a detour that the thought being
# captured is often gone by the time the title prompt shows up.
if [[ ("${action}" == "next" || "${action}" == "add") && "$*" != *--title* ]]; then
    # Prompt printed rather than passed to `read -p`, which stays silent
    # unless stdin is a terminal -- piped input would otherwise just hang
    # with no indication of what it's waiting for.
    printf 'Item title: ' >&2
    read -r title

    if [[ -z "${title}" ]]; then
        echo "backlog: title cannot be empty" >&2
        exit 1
    fi

    set -- "$@" --title "${title}"
fi

# next/add offer the same repo picker, but unlike `tag` an empty pick just
# means the new item stays untagged -- nothing to error out over.
if [[ ("${action}" == "next" || "${action}" == "add") && "$*" != *--repo* ]]; then
    repo="$(_backlog_repo_candidates | _backlog_pick_or_type "Tag with which repo (blank for none)?")"

    if [[ -n "${repo}" ]]; then
        set -- "$@" --repo "${repo}"
    fi
fi

_backlog_py "$@"
