#!/usr/bin/env bash
# A failed GitHub Actions run's logs, trimmed to the error regions.
#
# Thin on purpose: nothing interactive lives here, so the wrapper exists
# only to give the skill the executable name the `skill-tree` dispatcher
# and $PATH both expect, and to pick an interpreter. All argument
# handling lives in the Python.
set -euo pipefail

_here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

exec python3 "${_here}/debug_ci_cli.py" "$@"
