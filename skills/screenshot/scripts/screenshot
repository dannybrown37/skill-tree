#!/usr/bin/env bash
# Where this machine puts screenshots, which one is newest, and taking one.
#
# Deliberately small: an agent needs a path it can Read -- either of a shot
# the user just took, or of one it takes itself when the user is describing
# something on screen that never got attached. Picking and moving
# screenshots are an interactive concern and not in scope.
set -euo pipefail

CONFIG="${SCREENSHOT_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/skill-tree/screenshot-dir}"
WINDOWS_USERS_ROOT="${WINDOWS_USERS_ROOT:-/mnt/c/Users}"

# Extensions considered a screenshot. OneDrive drops a desktop.ini into the
# folder, which would otherwise come back as "the latest screenshot".
readonly IMAGE_EXTENSIONS=(png jpg jpeg gif webp bmp)

_die() {
    echo "screenshot: $*" >&2
    exit 1
}

# Every image in a directory, newest first, absolute.
_images() {
    local dir="$1" files=() extension
    shopt -s nullglob nocaseglob
    for extension in "${IMAGE_EXTENSIONS[@]}"; do
        files+=("${dir}"/*."${extension}")
    done
    shopt -u nullglob nocaseglob

    ((${#files[@]})) || return 0
    ls -t -- "${files[@]}"
}

# Standard screenshot locations for whatever this machine is, best first.
#
# WSL is checked by whether the Windows profile root is actually mounted
# rather than by parsing /proc/version -- the mount is the thing that has
# to exist for any of those paths to work.
_default_candidates() {
    local profile

    if [[ -d "${WINDOWS_USERS_ROOT}" ]]; then
        for profile in "${WINDOWS_USERS_ROOT}"/*/; do
            case "$(basename "${profile}")" in
            Public | Default | 'Default User' | 'All Users') continue ;;
            esac
            # OneDrive's "back up my Pictures" silently redirects the real
            # folder and leaves the old one behind, so both are candidates.
            echo "${profile}OneDrive/Pictures/Screenshots"
            echo "${profile}Pictures/Screenshots"
        done
    fi

    if [[ "$(uname -s)" == Darwin ]]; then
        # macOS keeps the location in a defaults key, and ships no folder
        # of its own -- screenshots land on the Desktop unless moved.
        local configured
        configured="$(defaults read com.apple.screencapture location 2>/dev/null || true)"
        [[ -n "${configured}" ]] && echo "${configured/#\~/${HOME}}"
        echo "${HOME}/Desktop"
    fi

    echo "${HOME}/Pictures/Screenshots"
    echo "${HOME}/Pictures"
}

# The configured directory, else whichever default holds the most recent
# image. "Whichever exists" isn't enough: a stale pre-OneDrive folder
# usually still exists, and is never the one the user just wrote to.
_resolve_dir() {
    if [[ -n "${SCREENSHOT_DIR:-}" ]]; then
        [[ -d "${SCREENSHOT_DIR}" ]] ||
            _die "\$SCREENSHOT_DIR is not a directory: ${SCREENSHOT_DIR}"
        echo "${SCREENSHOT_DIR}"
        return
    fi

    if [[ -f "${CONFIG}" ]]; then
        local configured
        configured="$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "${CONFIG}" | head -1)"
        [[ -d "${configured}" ]] ||
            _die "${CONFIG} points at a missing directory: ${configured}"
        echo "${configured}"
        return
    fi

    local candidate newest='' newest_dir='' first_existing='' image
    while read -r candidate; do
        [[ -d "${candidate}" ]] || continue
        [[ -n "${first_existing}" ]] || first_existing="${candidate}"

        image="$(_images "${candidate}" | head -1)"
        if [[ -n "${image}" && (-z "${newest}" || "${image}" -nt "${newest}") ]]; then
            newest="${image}"
            newest_dir="${candidate}"
        fi
    done < <(_default_candidates)

    if [[ -z "${newest_dir}" && -z "${first_existing}" ]]; then
        _die "no screenshots directory found. Set one with: $0 set <path>"
    fi
    echo "${newest_dir:-${first_existing}}"
}

_cmd_set() {
    local target="${1:-}"
    [[ -n "${target}" ]] || _die "set: which directory? (usage: $0 set <path>)"
    target="${target/#\~/${HOME}}"
    [[ -d "${target}" ]] || _die "set: not a directory: ${target}"

    # Absolute, so the config survives being read from anywhere.
    target="$(cd "${target}" && pwd)"
    mkdir -p "$(dirname "${CONFIG}")"
    printf '# Screenshots directory used by the skill-tree screenshot skill.\n%s\n' \
        "${target}" >"${CONFIG}"
    echo "Screenshots directory set to ${target}"
    echo "(${CONFIG} -- delete it to go back to auto-detection)"
}

# Windows' own naming, so a captured file sorts and reads like one taken
# with Win+PrtScn.
readonly CAPTURE_NAME_FORMAT='Screenshot %Y-%m-%d %H%M%S.png'

# VirtualScreen, not PrimaryScreen: a multi-monitor desktop should come out
# whole rather than silently cropped to whichever monitor Windows calls
# first. $OutPath is prepended by the caller -- `-Command` has no way to
# bind arguments, so the path has to be part of the script text.
# shellcheck disable=SC2016  # the $vars are PowerShell's, not bash's
readonly CAPTURE_SCRIPT='
Add-Type -AssemblyName System.Windows.Forms,System.Drawing
$bounds = [System.Windows.Forms.SystemInformation]::VirtualScreen
$bitmap = New-Object System.Drawing.Bitmap $bounds.Width, $bounds.Height
try {
    $graphics = [System.Drawing.Graphics]::FromImage($bitmap)
    try {
        $graphics.CopyFromScreen(
            $bounds.Location,
            [System.Drawing.Point]::Empty,
            $bounds.Size
        )
    } finally { $graphics.Dispose() }
    $bitmap.Save($OutPath, [System.Drawing.Imaging.ImageFormat]::Png)
} finally { $bitmap.Dispose() }
'

# A path like "$1" that names nothing yet. Two captures land in the same
# second easily, and a screenshot is not worth losing an older file over.
_free_path() {
    local base="$1" index=1 candidate="$1"
    while [[ -e "${candidate}" ]]; do
        candidate="${base%.png}-${index}.png"
        ((index++ < 1000)) || _die "too many files named like $(basename "${base}")"
    done
    echo "${candidate}"
}

# Single quotes don't interpolate in PowerShell, so doubling an embedded
# quote is the whole escape.
_ps_literal() {
    local escaped="${1//\'/\'\'}"
    echo "'${escaped}'"
}

_cmd_take() {
    local dir target windows_target output
    dir="$(_resolve_dir)"
    command -v powershell.exe >/dev/null 2>&1 ||
        _die "take needs Windows interop (powershell.exe), so it only works from WSL"

    target="$(_free_path "${dir}/$(date "+${CAPTURE_NAME_FORMAT}")")"
    windows_target="$(wslpath -w "${target}")" ||
        _die "could not translate ${target} to a Windows path"

    if ! output="$(powershell.exe -NoProfile -NonInteractive -Command \
        "\$OutPath = $(_ps_literal "${windows_target}")
${CAPTURE_SCRIPT}" 2>&1)"; then
        _die "capture failed: ${output:-no output}"
    fi
    [[ -f "${target}" ]] ||
        _die "capture reported success but wrote nothing to ${target}"

    echo "${target}"
}

_cmd_latest() {
    local dir image
    dir="$(_resolve_dir)"
    image="$(_images "${dir}" | head -1)"
    [[ -n "${image}" ]] || _die "no screenshots in ${dir}"
    echo "${image}"
}

_cmd_list() {
    local dir count="${1:-10}"
    dir="$(_resolve_dir)"
    _images "${dir}" | head -n "${count}"
}

# The plugin manifest three levels up, parsed with sed rather than jq --
# `--version` has to answer with no config and no extra tooling, so a
# missing manifest is `unknown` instead of a failure.
_version() {
    local here manifest version=''
    here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    manifest="${here}/../../../.claude-plugin/plugin.json"

    if [[ -f "${manifest}" ]]; then
        version="$(sed -n \
            's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "${manifest}" | head -1)"
    fi
    echo "screenshot ${version:-unknown}"
}

_usage() {
    cat <<EOF
Usage: screenshot <command>

  take          Capture the whole desktop, print the new file's path (WSL only)
  latest        Absolute path of the newest screenshot (what an agent wants)
  list [N]      The N newest, newest first (default 10)
  dir           The resolved screenshots directory
  set <path>    Remember <path> as the screenshots directory
  --version     This checkout's plugin version
  help          This screen

Resolution order: \$SCREENSHOT_DIR, then ${CONFIG},
then the standard location for this machine (WSL/macOS/Linux).
EOF
}

main() {
    local command="${1:-help}"
    shift || true

    case "${command}" in
    take) _cmd_take ;;
    latest) _cmd_latest ;;
    list) _cmd_list "$@" ;;
    dir) _resolve_dir ;;
    set) _cmd_set "$@" ;;
    help | -h | --help) _usage ;;
    --version | -V) _version ;;
    *) _die "unknown command: ${command} (try: $0 help)" ;;
    esac
}

main "$@"
